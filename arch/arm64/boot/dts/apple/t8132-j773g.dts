/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";

	aliases {
		bluetooth0 = &bluetooth0;
		ethernet0 = &ethernet0;
		pmp = &pmp;
		wifi0 = &wifi0;
	};

	vreg_pcie0_port0: regulator-pcie0-port0 {
		compatible = "regulator-fixed";
		regulator-name = "pwren-pcie0-port0";
		gpio = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
};

&smc_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	smc_reboot: reboot {
		compatible = "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			      <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
				   "boot_error_count", "panic_count";
	};

	smc_rtc: rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};
};

&nub_spmi {
	status = "okay";

	pmic1: pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			pm_setting: pm-setting@2001 {
				reg = <0x2001 0x1>;
			};

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			fault_shadow: fault-shadow@867b {
				reg = <0x867b 0x10>;
			};

			socd: socd@8b00 {
				reg = <0x8b00 0x1800>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

/* Internal SSD */

&ans_mbox {
	status = "okay";
};

&sart {
	status = "okay";
};

&nvme {
	status = "okay";
};

/*
 * Internal PCIe: Wi-Fi and Bluetooth (BCM4388) on port 0 and Ethernet on
 * port 2 (an AQC113 on the 10 Gb Ethernet model). Port 1 is not wired.
 * Fixed bus numbers let the device nodes below carry the MAC and
 * Bluetooth addresses and the calibration the loader fills in.
 */

&pcie0 {
	iommu-map = <0x100 &pcie0_dart 1 1>,
		    <0x200 &pcie2_dart 1 1>;
	status = "okay";
};

&pcie0_dart {
	status = "okay";
};

&pcie2_dart {
	status = "okay";
};

&pcie0_port0 {
	power-supply = <&vreg_pcie0_port0>;
	bus-range = <1 1>;
	status = "okay";

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
		brcm,board-type = "apple,sakhalin";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
		brcm,board-type = "apple,sakhalin";
	};
};

&pcie0_port2 {
	bus-range = <2 2>;
	status = "okay";

	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

/* CPU frequency scaling */

&cpufreq_e {
	status = "okay";
};

&cpufreq_p {
	status = "okay";
};

&cpu_e0 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_e1 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_e2 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_e3 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_e4 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_e5 {
	operating-points-v2 = <&donan_e_opp>;
	performance-domains = <&cpufreq_e>;
};

&cpu_p0 {
	operating-points-v2 = <&donan_p_opp>;
	performance-domains = <&cpufreq_p>;
};

&cpu_p1 {
	operating-points-v2 = <&donan_p_opp>;
	performance-domains = <&cpufreq_p>;
};

&cpu_p2 {
	operating-points-v2 = <&donan_p_opp>;
	performance-domains = <&cpufreq_p>;
};

&cpu_p3 {
	operating-points-v2 = <&donan_p_opp>;
	performance-domains = <&cpufreq_p>;
};

/* SMC sensors and the fan */

#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"

&pmp_dart {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

/*
 * The requests GravityLinux's J773g tree holds while the PMP runs;
 * pmp-boot-f and pmp-boot-10 are the start-up requests macOS asserts
 * before it starts the PMP. The PMP node itself stays disabled here: the
 * bootloader copies the board and DRAM identifiers and the PMP tunables
 * from the Apple device tree, then enables it.
 */
&pmp_report {
	status = "okay";

	report@7 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x7>;
		label = "pmp-disp";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@f {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0xf>;
		label = "pmp-boot-f";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@10 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x10>;
		label = "pmp-boot-10";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@11 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x11>;
		label = "pmp-dispext1";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext1_sys>;
		apple,always-on;
	};

	report@12 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x12>;
		label = "pmp-atc0-common";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@13 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x13>;
		label = "pmp-atc1";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@14 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x14>;
		label = "pmp-atc2";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@15 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x15>;
		label = "pmp-atc3-common";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@16 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x16>;
		label = "pmp-soc-ni0";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@17 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x17>;
		label = "pmp-soc-ni1";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@18 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x18>;
		label = "pmp-boot-18";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@19 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x19>;
		label = "pmp-soc-ni3";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@1a {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x1a>;
		label = "pmp-soc-ni4";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@1b {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x1b>;
		label = "pmp-soc-ni5";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@1d {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x1d>;
		label = "pmp-ans";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@1e {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x1e>;
		label = "pmp-pcie";
		#power-domain-cells = <0>;
		apple,always-on;
	};

	report@22 {
		compatible = "apple,t8140-pmp-v2-report-entry";
		reg = <0x22>;
		label = "pmp-sio";
		#power-domain-cells = <0>;
	};
};

/*
 * Without votes the PMP parks DRAM low. CLPC votes DCS 5 / fabric 3
 * through the AP's agent while a CPU cluster is busy or the GPU is
 * powered.
 */
&pmc {
	status = "okay";
};
