 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";

	aliases {
		ans = &nvme;
		ans-mbox = &ans_mbox;
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		atcphy2 = &atcphy2;
		atcphy3 = &atcphy3;
		bluetooth0 = &bluetooth0;
		dcpext0 = &dcpext0;
		disp0 = &display;
		dispext0_piodma = &dispext0_piodma;
		ethernet0 = &ethernet0;
		pmp = &pmp;
		pmu-primary = &pmic1;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	/*
	 * Protected mono internal speaker (snd-t8132-speaker): MCA TX0 into
	 * the SN012776 amplifier, with an in-kernel thermal limiter.
	 */
	speaker-audio {
		compatible = "apple,j773g-speaker";
		apple,mca = <&mca>;
		apple,codec = <&speaker_amp>;
	};

	chosen {
		linux-enablement-mac,dapf-handoff = "/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";
	};
};

/*
 * The GPU's power votes go through the existing PMP. The J773g ADT carries the
 * same 34-entry PMP table as J713 (GFX at entry 12, DISP at entry 15), and the
 * same GPU apertures, interrupts and firmware segments.
 */
&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

/* Same memory-controller settings as J713 (static-voters copied, unverified on J773g). */
&mcc {
	status = "okay";
	apple,boot-dma-devices = <&pmp>;
};

&pmc {
	status = "okay";
	apple,static-voters = <3>;
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
};

/*
 * HDMI: dcpext0 -> display crossbar -> DPTX PHY (ADT dptx-phy,
 * dp-switch-dfp-endpoint 4) -> on-board DP-to-HDMI converter (ADT
 * dp2hdmi-gpio0: hdmi_pwr_en SMC gP0f, dp2hdmi_pwr_en SMC gP1a, hdmi_hpd
 * AOP GPIO 0x29). dcpext0 is the pipe iBoot leaves on the port: the boot
 * framebuffer needs DISPEXT0 and the DPTX PHY powered.
 *
 * The PHY's probe touches no registers and is enabled here. The display
 * processor, its mailbox, both DARTs and the display subsystem stay
 * disabled: the boot loader enables them once it has published dcpext0's
 * firmware identity (apple,firmware-version/-compat/-uuid), its firmware
 * memory with the live iommu-addresses and the boot framebuffer, and locked
 * dart-dcpext0 and dart-dispext0. Without that the display stays on the
 * boot framebuffer.
 */
&soc {
	display: display-subsystem {
		compatible = "apple,display-subsystem";
		iommus = <&dispext0_dart 0>;
		/* scanout surfaces are real-time memory, as on T6041 */
		dma-noncoherent;
		status = "disabled"; /* Enabled by the loader. */
	};
};

&dptxphy {
	status = "okay";
};

&dcpext0 {
	apple,connector-type = "HDMI-A";
	/* primary and overlay surfaces, as the T6041 external processors */
	apple,iomfb-surfaces = <1 1 0 0>;
	phys = <&dptxphy>;
	phy-names = "dp-phy";
	apple,dptx-phy = <4>;
	hdmi-hpd-gpios = <&pinctrl_aop 41 GPIO_ACTIVE_HIGH>;
	hdmi-pwren-gpios = <&smc_gpio 15 GPIO_ACTIVE_HIGH>;
	dp2hdmi-pwren-gpios = <&smc_gpio 26 GPIO_ACTIVE_HIGH>;
	/* status: enabled by the loader, with dcpext0_mbox and both DARTs */
};

/*
 * Built-in PCIe (J773g ADT /arm-io/apcie): port 0 carries the BCM4388
 * Wi-Fi/Bluetooth module ("sakhalin"), port 2 the on-board Ethernet. Port 1
 * is not wired on this board.
 */
&dart_apcie0 {
	status = "okay";
};

&dart_apcie2 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	bus-range = <0 2>;
	iommu-map = <0x100 &dart_apcie0 16 1>,
		    <0x200 &dart_apcie2 16 1>;
	iommu-map-mask = <0xff00>;
};

&port00 {
	/* ADT wlan function-reg_on = SMC key gP13; pci-bridge0 PERST# GPIO 0xa3. */
	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,sakhalin";
		/* To be filled by the loader */
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		brcm,board-type = "apple,sakhalin";
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
	};
};

&port02 {
	status = "okay";
	/* ADT pci-bridge2 PERST# GPIO 0xa5. */
	reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>;

	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

/*
 * Rear USB-C ports (J773g ADT nub-spmi-a0 hpm0/1/3, port-location):
 * hpm0 -> ATC0 back-middle, hpm1 -> ATC1 back-left, hpm3 -> ATC3 back-right.
 * Data starts USB2-only, as the J713 ports did.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		/*
		 * ADT hpm0 lists irq, sleep, wake only. Gravity adds select at
		 * irq + 2 (Gravity 4cb9998f58 fixed SID 8 to 65, tested on J773g).
		 */
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back-middle";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		/*
		 * ADT hpm1 lists irq, sleep, wake only. Gravity adds select at
		 * irq + 2 (Gravity 4cb9998f58 fixed SID 8 to 65, tested on J773g).
		 */
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back-left";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};

	hpm3: usb-pd@8 {
		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		/*
		 * ADT hpm3 lists irq, sleep, wake only. Gravity adds select at
		 * irq + 2 (Gravity 4cb9998f58 fixed SID 8 to 65, tested on J773g).
		 */
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <65 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec3: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back-right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec3_connector_hs: endpoint {
						remote-endpoint = <&dwc3_3_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec3_connector_ss: endpoint {
						remote-endpoint = <&atcphy3_typec_lanes>;
					};
				};
			};
		};
	};
};

&atcphy0 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	status = "okay";
	dr_mode = "host";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};
	};
};

&atcphy1 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy1_typec_lanes: endpoint {
				remote-endpoint = <&typec1_connector_ss>;
			};
		};
	};
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	status = "okay";
	dr_mode = "host";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};
	};
};

&atcphy3 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy3_typec_lanes: endpoint {
				remote-endpoint = <&typec3_connector_ss>;
			};
		};
	};
};

&dwc3_3_dart_0 {
	status = "okay";
};

&dwc3_3_dart_1 {
	status = "okay";
};

&dwc3_3 {
	status = "okay";
	dr_mode = "host";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_3_hs: endpoint {
				remote-endpoint = <&typec3_connector_hs>;
			};
		};
	};
};

/* SuperSpeed on the rear ports, using the J713 ATC1 bank layout. */
&atcphy0 {
	/* SuperSpeed banks inside ADT atc-phy0 apertures; display crossbar (+0x4c000) excluded. */
	reg = <0x4 0x02a90000 0x0 0x4000>,
	      <0x4 0x02a84000 0x0 0x4000>,
	      <0x4 0x03000000 0x0 0x24000>,
	      <0x4 0x00000000 0x0 0x8000>,
	      <0x4 0x00020000 0x0 0x4000>,
	      <0x4 0x03044000 0x0 0x4000>,
	      <0x4 0x03050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
};

&dwc3_0 {
	maximum-speed = "super-speed";
	phys = <&atcphy0 PHY_TYPE_USB2>, <&atcphy0 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
};

&atcphy1 {
	/* SuperSpeed banks inside ADT atc-phy1 apertures; display crossbar (+0x4c000) excluded. */
	reg = <0x4 0x0aa90000 0x0 0x4000>,
	      <0x4 0x0aa84000 0x0 0x4000>,
	      <0x4 0x0b000000 0x0 0x24000>,
	      <0x4 0x08000000 0x0 0x8000>,
	      <0x4 0x08020000 0x0 0x4000>,
	      <0x4 0x0b044000 0x0 0x4000>,
	      <0x4 0x0b050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
};

&dwc3_1 {
	maximum-speed = "super-speed";
	phys = <&atcphy1 PHY_TYPE_USB2>, <&atcphy1 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
};

&atcphy3 {
	/* SuperSpeed banks inside ADT atc-phy3 apertures; display crossbar (+0x4c000) excluded. */
	reg = <0x4 0x1aa90000 0x0 0x4000>,
	      <0x4 0x1aa84000 0x0 0x4000>,
	      <0x4 0x1b000000 0x0 0x24000>,
	      <0x4 0x18000000 0x0 0x8000>,
	      <0x4 0x18020000 0x0 0x4000>,
	      <0x4 0x1b044000 0x0 0x4000>,
	      <0x4 0x1b050000 0x0 0x4000>;
	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
		    "fabric", "common-config";
};

&dwc3_3 {
	maximum-speed = "super-speed";
	phys = <&atcphy3 PHY_TYPE_USB2>, <&atcphy3 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
};

/*
 * The two front ports sit behind a permanently attached GL3590 hub on ATC2
 * (ADT usb3hub-fw: reset GPIO 0xc6, flash OE GPIO 0x65). No Type-C
 * controller: host only, USB2 until atc.c learns apple,fixed-usb3.
 */
&atcphy2 {
	status = "okay";
	/delete-property/ orientation-switch;
	/delete-property/ mode-switch;
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	status = "okay";
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	/delete-property/ role-switch-default-mode;
};

&pinctrl_ap {
	usb3hub-flash-oe-hog {
		gpio-hog;
		gpios = <101 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb3hub-flash-oe";
	};

	usb3hub-reset-hog {
		gpio-hog;
		gpios = <198 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb3hub-reset";
	};
};

&smc {
	status = "okay";

	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
	};

	/*
	 * Poweroff and restart go through SMC key MBSE (J773g ADT pmu-main
	 * function-external_standby = keyW('MBSE')). shutdown_flag (PMU boot
	 * key 0xf bit 3, as on J713 and t8103/t8122) keeps the PMU off after
	 * 'off1'; without it an M6 mini was seen to restart instead.
	 */
	smc_reboot: reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			<&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
			"boot_error_count", "panic_count";
	};
};

&smc_mbox {
	status = "okay";
};

/*
 * Primary PMU (Abbey), J773g ADT /arm-io/nub-spmi0/pmu-main: compatible
 * "pmu,spmi", "pmu,abbey", is-primary = 1, reg = 0xe, info-rtc_scrpad =
 * 0x2100, info-leg_scrpad = 0xf800. That is the same PMU and scratchpad
 * layout as the J713, so the NVMEM cells below are the J713 ones.
 *
 * m1n1 only transfers the SPMI range and slave ID for the J713, so the
 * values from the J773g ADT are written here (nub-spmi0 reg[0] =
 * 0x188714000, size 0x4000; the ADT's 0x1xxxxxxxx maps to 0x3xxxxxxxx
 * as for the SMC). The aliases above let a loader that does transfer
 * them on J773g overwrite these with the same values.
 */
&nub_spmi {
	reg = <0x3 0x88714000 0x0 0x4000>;
	status = "okay";

	pmic1: pmic@e {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0xe SPMI_USID>;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"

#include "t8132-gpu.dtsi"

&pmgr_audio {
	status = "okay";
};

&dart_audio {
	status = "okay";
};

&admac {
	status = "okay";
};

&mca {
	status = "okay";
};

/* ADT /arm-io/i2c3/audio-speaker: SN012776 at 0x38, shutdown on AP GPIO 15. */
&i2c3 {
	status = "okay";

	speaker_amp: amplifier@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		#sound-dai-cells = <0>;
		shutdown-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The front 3.5 mm jack: a CS42L84 (ADT /arm-io/i2c1/audio-codec-output@4B).
 * Its reset line is nub GPIO 0x11, driven high to run the codec (the
 * driver's "reset" is an enable, as on the other Apple boards); its
 * interrupt is AP GPIO 98, level low.
 *
 * Nothing links it into a sound card yet. The ADT feeds the jack from the
 * AOP's audio-codec-output stream on base ADMAC channel 4 (TX2) and the
 * headset microphone on channel 5 (RX2), i.e. MCA cluster 2, which the
 * T8132 MCA variant does not describe; only TX0 (the speaker) is mapped.
 * With the codec bound, jack playback needs either that cluster or the
 * AOP audio path that Aurora uses on T6040.
 */
&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};
